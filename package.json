{
  "name": "football-prediction-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "email:preview": "tsx scripts/preview-emails.ts",
    "store:seed": "tsx scripts/seed-store-demo.ts",
    "store:proxy": "node scripts/serve-store-proxy.mjs",
    "store:capture": "node scripts/capture-store-shots.mjs",
    "store:promos": "node scripts/build-store-promos.mjs",
    "store:shots": "npm run store:capture && npm run store:promos"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.21.0",
    "prisma": "^7.10.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "better-sqlite3@12.10.1": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
