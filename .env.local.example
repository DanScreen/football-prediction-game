# Anthropic — needed for AI result lookup (Claude + web search).
# Get one at https://console.anthropic.com. Leave empty to use manual-only mode.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# NextAuth / Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=your_nextauth_secret_here

# Prisma / SQLite — path to the local database file (relative to project root)
DATABASE_URL=file:./prisma/dev.db
