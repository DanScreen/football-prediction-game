# Anthropic — needed for AI result lookup (Claude + web search) and league creation fixture auto-import.
# Get one at https://console.anthropic.com. Leave empty to disable AI features.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# football-data.org — needed for the admin fixture import tab.
# Free tier covers Premier League and World Cup. Register at https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here

# NextAuth / Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=your_nextauth_secret_here

# Prisma / SQLite — path to the local database file (relative to project root)
DATABASE_URL=file:./dev.db
