# football-data.org — fixture import and result lookup.
# Free tier covers Premier League and World Cup. Register at https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here

# NextAuth / Auth.js — generate with: openssl rand -base64 32
# Both are required by NextAuth v5 beta; use the same value for each.
AUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_SECRET=your_nextauth_secret_here

# PostgreSQL database URL.
# Local dev: this matches `docker compose up -d` (docker-compose.yml), which runs
# Postgres on 55432 rather than 5432 so it can't clash with a host install.
# Production (Cloud Run): set via GitHub Secret DATABASE_URL (Terraform output).
DATABASE_URL=postgresql://postgres:localdev@localhost:55432/football_prediction_app

# Comma-separated emails granted the site-host role on login (optional).
SITE_ADMIN_EMAILS=you@example.com
