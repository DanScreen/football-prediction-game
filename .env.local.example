# football-data.org — fixture import and result lookup.
# Free tier covers Premier League and World Cup. Register at https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here

# NextAuth / Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=your_nextauth_secret_here

# PostgreSQL database URL
# Local dev: postgresql://user:password@localhost:5432/footy_predictor
# Production (Cloud Run): set via GitHub Secret DATABASE_URL (Terraform output)
DATABASE_URL=postgresql://user:password@localhost:5432/footy_predictor
