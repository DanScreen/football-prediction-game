generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FixtureStatus {
  SCHEDULED
  AWAITING_RESULT
  COMPLETED
}

enum ResultSource {
  MANUAL
  AI_CONFIRMED
}

enum SubmitVia {
  WEB
  API
}

model User {
  id           String                @id @default(cuid())
  email        String                @unique
  passwordHash String
  displayName  String
  isBot        Boolean               @default(false)
  // Site host — may manage competitions, canonical fixtures, and confirm
  // results platform-wide. Synced from SITE_ADMIN_EMAILS at login.
  isSiteAdmin  Boolean               @default(false)
  // Set when the user clicks the link in a verification email (or completes a
  // password reset, which proves the same thing). Null = unverified: the web
  // and the mobile API gate the account until it's set.
  emailVerifiedAt DateTime?
  apiKey       String                @unique @default(cuid())
  createdAt    DateTime              @default(now())
  // Last meaningful presence (login, prediction, mobile refresh). Throttled
  // writes via touchLastSeen() — see lib/lastSeen.ts. Used for host DAU/WAU/MAU.
  lastSeenAt   DateTime?
  memberships      LeagueMembership[]
  predictions      Prediction[]
  bonusAwards      BonusAward[]
  resetTokens      PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  mobileRefreshTokens MobileRefreshToken[]
  mobileDeviceTokens  MobileDeviceToken[]

  @@index([lastSeenAt])
}

// A real-world competition (Premier League, World Cup…) owned by site hosts.
// Fixtures are canonical per competition; leagues subscribe to one competition.
model Competition {
  id        String    @id @default(cuid())
  name      String    @unique
  // football-data.org competition code ("PL", "WC"); null = manual-only
  code      String?
  flag      String    @default("")
  // Included in auto-import and selectable at league creation
  isActive   Boolean   @default(true)
  // Set when a host declares the competition finished. An archived competition
  // keeps all its fixtures, predictions and standings, but drops out of the
  // player-facing core pages (predict / results / leaderboard) and out of the
  // auto-import and reminder sweeps. Distinct from `isActive`, which only says
  // whether new leagues may subscribe — a season can be closed to new leagues
  // while still being played.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  leagues    League[]
  fixtures   Fixture[]
}

// Single-use, expiring token for the forgot-password flow. Only the SHA-256
// hash of the token is stored — the raw value only ever exists in the email link.
// Single-use link sent to prove a user owns their email address. Only the
// SHA-256 of the raw token is stored. `email` pins the token to the address it
// was sent to, so changing the address orphans any link already in flight.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

// Opaque refresh token for the native mobile API (`/api/mobile/v1`). Only the
// SHA-256 hash is stored; the raw token lives in the app's SecureStore. Rotated
// on every refresh; revoked on logout.
model MobileRefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Expo push token for deadline reminders on the native app.
model MobileDeviceToken {
  id            String   @id @default(cuid())
  userId        String
  expoPushToken String   @unique
  platform      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model League {
  id               String             @id @default(cuid())
  name             String
  competitionId    String
  inviteCode       String             @unique
  createdAt        DateTime           @default(now())
  competition      Competition        @relation(fields: [competitionId], references: [id])
  memberships      LeagueMembership[]
  bonusAwards      BonusAward[]
}

model LeagueMembership {
  id       String   @id @default(cuid())
  userId   String
  leagueId String
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])
  league   League   @relation(fields: [leagueId], references: [id])

  @@unique([userId, leagueId])
}

// Canonical fixture — one row per real-world match, shared by every league
// subscribed to the competition.
model Fixture {
  id              String        @id @default(cuid())
  competitionId   String
  round           String
  homeTeam        String
  awayTeam        String
  kickoffTime     DateTime
  status          FixtureStatus @default(SCHEDULED)
  actualHomeScore Int?
  actualAwayScore Int?
  // Score proposed by the automated football-data.org sweep — shown to users
  // as provisional until a site host confirms
  proposedHomeScore Int?
  proposedAwayScore Int?
  // When deadline-reminder emails were sent for this fixture (one batch per fixture)
  reminderSentAt  DateTime?
  resultSource    ResultSource?
  createdAt       DateTime      @default(now())
  competition     Competition   @relation(fields: [competitionId], references: [id])
  predictions     Prediction[]

  // Canonical dedupe key — auto-import relies on createMany(skipDuplicates)
  @@unique([competitionId, homeTeam, awayTeam, kickoffTime])
}

// A per-round bonus (currently only the streak bonus), kept separate from
// Prediction.pointsAwarded so base points stay pure and bonuses are visible
model BonusAward {
  id        String   @id @default(cuid())
  userId    String
  leagueId  String
  // Round labels are unique within a league's competition, so (user, league,
  // round) fully identifies a bonus
  round     String
  points    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  league    League   @relation(fields: [leagueId], references: [id])

  @@unique([userId, leagueId, round])
}

model Prediction {
  id                 String    @id @default(cuid())
  userId             String
  fixtureId          String
  predictedHomeScore Int
  predictedAwayScore Int
  // The user's "banker" for this fixture's round: points doubled. At most one
  // per (user, competition, round) — the round lives on Fixture, so this can't
  // be a DB constraint; `setBanker()` enforces it transactionally.
  isBanker           Boolean   @default(false)
  // Base points × the banker multiplier — i.e. what actually counts.
  pointsAwarded      Float?
  submittedVia       SubmitVia @default(WEB)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id])
  fixture            Fixture   @relation(fields: [fixtureId], references: [id])

  @@unique([userId, fixtureId])
}
