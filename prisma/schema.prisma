generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FixtureStatus {
  SCHEDULED
  AWAITING_RESULT
  COMPLETED
}

enum ResultSource {
  MANUAL
  AI_CONFIRMED
}

enum SubmitVia {
  WEB
  API
}

model User {
  id           String                @id @default(cuid())
  email        String                @unique
  passwordHash String
  displayName  String
  isBot        Boolean               @default(false)
  apiKey       String                @unique @default(cuid())
  createdAt    DateTime              @default(now())
  memberships  LeagueMembership[]
  predictions  Prediction[]
  bonusAwards  BonusAward[]
  resetTokens  PasswordResetToken[]
}

// Single-use, expiring token for the forgot-password flow. Only the SHA-256
// hash of the token is stored — the raw value only ever exists in the email link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

model League {
  id               String             @id @default(cuid())
  name             String
  competition      String             @default("")
  inviteCode       String             @unique
  grandSlamEnabled Boolean            @default(false)
  grandSlamPoints  Int                @default(3)
  createdAt        DateTime           @default(now())
  memberships      LeagueMembership[]
  fixtures         Fixture[]
  bonusAwards      BonusAward[]
}

model LeagueMembership {
  id       String   @id @default(cuid())
  userId   String
  leagueId String
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])
  league   League   @relation(fields: [leagueId], references: [id])

  @@unique([userId, leagueId])
}

model Fixture {
  id              String        @id @default(cuid())
  leagueId        String
  competition     String
  round           String
  homeTeam        String
  awayTeam        String
  kickoffTime     DateTime
  status          FixtureStatus @default(SCHEDULED)
  actualHomeScore Int?
  actualAwayScore Int?
  // Score proposed by the automated football-data.org sweep, awaiting Commissioner confirmation
  proposedHomeScore Int?
  proposedAwayScore Int?
  // When deadline-reminder emails were sent for this fixture (one batch per fixture)
  reminderSentAt  DateTime?
  resultSource    ResultSource?
  createdAt       DateTime      @default(now())
  league          League        @relation(fields: [leagueId], references: [id])
  predictions     Prediction[]
}

// A per-round bonus (currently only the Grand Slam), kept separate from
// Prediction.pointsAwarded so base points stay pure and bonuses are visible
model BonusAward {
  id          String   @id @default(cuid())
  userId      String
  leagueId    String
  competition String
  round       String
  points      Int
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  league      League   @relation(fields: [leagueId], references: [id])

  @@unique([userId, leagueId, competition, round])
}

model Prediction {
  id                 String    @id @default(cuid())
  userId             String
  fixtureId          String
  predictedHomeScore Int
  predictedAwayScore Int
  pointsAwarded      Float?
  submittedVia       SubmitVia @default(WEB)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id])
  fixture            Fixture   @relation(fields: [fixtureId], references: [id])

  @@unique([userId, fixtureId])
}
