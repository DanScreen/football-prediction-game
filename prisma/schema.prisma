generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum FixtureStatus {
  SCHEDULED
  AWAITING_RESULT
  COMPLETED
}

enum ResultSource {
  MANUAL
  AI_CONFIRMED
}

enum SubmitVia {
  WEB
  API
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  isAdmin      Boolean  @default(false)
  isBot        Boolean  @default(false)
  apiKey       String   @unique @default(cuid())
  createdAt    DateTime @default(now())

  predictions Prediction[]
}

model LeagueSettings {
  id               Int     @id @default(autoincrement())
  leagueName       String  @default("Footy Predictor")
  inviteCode       String
  grandSlamEnabled Boolean @default(false)
  grandSlamPoints  Int     @default(3)
}

model Fixture {
  id              String        @id @default(cuid())
  competition     String
  round           String
  homeTeam        String
  awayTeam        String
  kickoffTime     DateTime
  status          FixtureStatus @default(SCHEDULED)
  actualHomeScore Int?
  actualAwayScore Int?
  resultSource    ResultSource?
  createdAt       DateTime      @default(now())

  predictions Prediction[]
}

model Prediction {
  id                 String    @id @default(cuid())
  userId             String
  fixtureId          String
  predictedHomeScore Int
  predictedAwayScore Int
  pointsAwarded      Float?
  submittedVia       SubmitVia @default(WEB)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  fixture Fixture @relation(fields: [fixtureId], references: [id])

  @@unique([userId, fixtureId])
}
